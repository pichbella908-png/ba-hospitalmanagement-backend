# Copy to .env and edit. Never commit .env.
PORT=3000
HOST=127.0.0.1

# PostgreSQL connection string:
# DATABASE_URL=postgresql://postgres:your_password@127.0.0.1:5432/sovanvitou

# Or individual PostgreSQL parameters:
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_postgres_password
PGDATABASE=sovanvitou
PGADMIN_DATABASE=postgres
# PGSSL=true # for cloud PostgreSQL (Supabase, Neon, AWS RDS, etc.)

# 32+ random chars. If empty, a secret is generated and stored in the database.
JWT_SECRET=

# Separate, system-owner-only access to clinic database management.
SYSTEM_OWNER_EMAIL=tepsochet70@gmail.com
SYSTEM_OWNER_PASSWORD=

# Clinic signup approval mail. On Render Free, use the Brevo HTTPS API instead of SMTP.
APP_URL=https://your-clinic-app.example.com
EMAIL_PROVIDER=brevo
EMAIL_FROM=
BREVO_API_KEY=

# Used when EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Cambodia is UTC+7; used for "today" and the daily report
TZ_OFFSET_HOURS=7

# Only set if the frontend is served from a different origin
CORS_ORIGIN=

# Optional legacy/seed administrator; public clinic accounts must use signup and approval.
ADMIN_EMAIL=
ADMIN_PASSWORD=
